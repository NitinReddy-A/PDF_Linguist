# PDF Linguist reads these optional settings from the environment, or from a .env
# file in the directory you run it from. Copy this file to .env to use it.
# Nothing here is required, and PDF Linguist needs no API keys.

# Default translation engine: google | indictrans
PDF_LINGUIST_TRANSLATOR=google

# Resolution used to OCR scanned pages (higher = slower, more accurate).
PDF_LINGUIST_OCR_DPI=300

# Folder that contains Tesseract's *.traineddata files, if it is not found automatically.
# Windows example: C:\Program Files\Tesseract-OCR\tessdata
# TESSDATA_PREFIX=

# IndicTrans2 models are gated on Hugging Face. Accept their terms, then either run
# `huggingface-cli login` or put your personal token here. Never commit a real .env file.
# HF_TOKEN=
